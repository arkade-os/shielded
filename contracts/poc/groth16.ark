            int scalar25 = signals[25];
            ECPoint product25 = ecMul(baseX25, baseY25, scalar25, 2);
            ECPoint sum25 = ecAdd(accumulatorX, accumulatorY, product25.x, product25.y, 2);
            accumulatorX = sum25.x;
            accumulatorY = sum25.y;
        } else { require(true); }
        if (signals[26] > 0) {
            int baseX26 = key.icX[27];
            int baseY26 = key.icY[27];
            int scalar26 = signals[26];
            ECPoint product26 = ecMul(baseX26, baseY26, scalar26, 2);
            ECPoint sum26 = ecAdd(accumulatorX, accumulatorY, product26.x, product26.y, 2);
            accumulatorX = sum26.x;
            accumulatorY = sum26.y;
        } else { require(true); }
        if (signals[27] > 0) {
            int baseX27 = key.icX[28];
            int baseY27 = key.icY[28];
            int scalar27 = signals[27];
            ECPoint product27 = ecMul(baseX27, baseY27, scalar27, 2);
            ECPoint sum27 = ecAdd(accumulatorX, accumulatorY, product27.x, product27.y, 2);
            accumulatorX = sum27.x;
            accumulatorY = sum27.y;
        } else { require(true); }
        if (signals[28] > 0) {
            int baseX28 = key.icX[29];
            int baseY28 = key.icY[29];
            int scalar28 = signals[28];
            ECPoint product28 = ecMul(baseX28, baseY28, scalar28, 2);
            ECPoint sum28 = ecAdd(accumulatorX, accumulatorY, product28.x, product28.y, 2);
            accumulatorX = sum28.x;
            accumulatorY = sum28.y;
        } else { require(true); }
        if (signals[29] > 0) {
            int baseX29 = key.icX[30];
            int baseY29 = key.icY[30];
            int scalar29 = signals[29];
            ECPoint product29 = ecMul(baseX29, baseY29, scalar29, 2);
            ECPoint sum29 = ecAdd(accumulatorX, accumulatorY, product29.x, product29.y, 2);
            accumulatorX = sum29.x;
            accumulatorY = sum29.y;
        } else { require(true); }
        int[24] coordinates = [
            proof.a.x, proof.a.y,
            proof.b.xc1, proof.b.xc0, proof.b.yc1, proof.b.yc0,
            proof.c.x, proof.c.y,
            key.deltaNeg.xc1, key.deltaNeg.xc0, key.deltaNeg.yc1, key.deltaNeg.yc0,
            accumulatorX, accumulatorY,
            key.gammaNeg.xc1, key.gammaNeg.xc0, key.gammaNeg.yc1, key.gammaNeg.yc0,
            key.alpha.x, key.alpha.y,
            key.betaNeg.xc1, key.betaNeg.xc0, key.betaNeg.yc1, key.betaNeg.yc0
        ];
        require(ecPairingProduct(coordinates, 2), "invalid transition proof");
    }
}
