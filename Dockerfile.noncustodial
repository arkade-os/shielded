FROM golang:1.26.6-bookworm AS go
FROM node:24-bookworm AS build
COPY --from=go /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"
WORKDIR /app
COPY package.json package-lock.json ./
COPY tools/patch-sdk.mjs tools/patch-sdk.mjs
RUN npm ci
COPY . .
RUN cd tools/vm && go mod download
RUN npm run vm:registry:build && npm run build

FROM node:24-bookworm-slim AS runtime
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8789 SHIELDED_NETWORK=local-emulator SHIELDED_DATA_DIR=/data
WORKDIR /app
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/package.json ./package.json
COPY --from=build --chown=node:node /app/src ./src
COPY --from=build --chown=node:node /app/packages ./packages
COPY --from=build --chown=node:node /app/circuits/build ./circuits/build
COPY --from=build --chown=node:node /app/artifacts ./artifacts
COPY --from=build --chown=node:node /app/app/dist ./app/dist
COPY --from=build --chown=node:node /app/bin/shielded-registry-vm ./bin/shielded-registry-vm
RUN mkdir /data && chown node:node /data
USER node
EXPOSE 8789
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=10s --timeout=3s CMD ["node", "-e", "fetch('http://127.0.0.1:8789/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "--experimental-eventsource", "--import", "tsx", "src/noncustodial/server.ts"]
