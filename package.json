{
  "name": "@arkade-os/shielded-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preserver": "node tools/patch-swap-claim.mjs",
    "server": "node --experimental-eventsource --import tsx src/server.ts",
    "preapp": "node tools/patch-swap-claim.mjs",
    "app": "vite --config app/vite.config.ts --host 127.0.0.1 --force",
    "prebuild": "node tools/patch-swap-claim.mjs",
    "build": "tsc --noEmit && vite build --config app/vite.config.ts",
    "pretest": "node tools/patch-swap-claim.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "vm:build": "node --import tsx tools/build-vm.ts",
    "circom": "node tools/prepare-circom.mjs",
    "rollup:compile": "node circuits/rollup/generate.mjs",
    "rollup:compile:epoch": "node circuits/rollup/generate-epoch.mjs",
    "rollup:pin": "node tools/rollup-r1cs-pin.mjs",
    "rollup:budget:epoch": "node --max-old-space-size=8192 tools/rollup-epoch-budget.mjs",
    "test:rollup:witness": "node --import tsx tools/rollup-circuit-witness-smoke.ts",
    "test:rollup:epoch-witness": "node --import tsx tools/rollup-epoch-circuit-witness-smoke.ts",
    "funding": "node --experimental-eventsource --import tsx tools/stock-funding-wallet.ts",
    "fallback": "node --max-old-space-size=8192 --experimental-eventsource --import tsx tools/rollup-fallback.ts"
  },
  "dependencies": {
    "@arkade-os/lnurl-client": "0.6.0",
    "@arkade-os/sdk": "0.5.0-rc.20",
    "@arkade-os/swap": "0.1.0-rc.23",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@scure/btc-signer": "2.4.1",
    "circomlib": "2.0.5",
    "circomlibjs": "0.1.7",
    "compression": "1.8.2",
    "express": "5.3.0",
    "ffjavascript": "^0.3.1",
    "nostr-tools": "2.25.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "snarkjs": "0.7.6"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
