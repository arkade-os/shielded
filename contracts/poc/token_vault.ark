pragma arkade ^0.1.0;
import "./resource.ark";
contract PocTokenVault(bytes32 gateProgram, bytes32 applyClosure, bytes32 sealClosure, AssetId identity, AssetId tokenAsset) {
    function advance() {
        Resource.leader(gateProgram, applyClosure, sealClosure);
        Resource.continueIdentity(identity, 2);
        require(tx.outputs[2].value == tx.inputs[2].value, "token carrier");
        require(identity.txid != tokenAsset.txid || identity.gidx != tokenAsset.gidx);
    }
}
