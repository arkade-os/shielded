SHIELDED_ARK_URL=https://mutinynet.arkade.sh
SHIELDED_EMULATOR_URL=https://emulator.mutinynet.arkade.sh
SHIELDED_DATA_DIR=/data

# Optional. Defaults to the Arkade URL.
# SHIELDED_INDEXER_URL=

# Optional. Comma-separated origins whose browser apps may call the pool API, for example an app using @arkade-os/shielded.
# SHIELDED_ALLOWED_ORIGINS=https://wallet.example

# Deposit fee. It is off without these four: set the address and view key of a separate fee wallet, and a SATS or BPS above 0. A fee set only in part, or under a misspelled name, stops the pool until it is fixed.
# The fee can be turned on once this version of the wallet is deployed. Older pages and package versions cannot pay it, so the pool refuses their deposits with a message to reload.
# SHIELDED_DEPOSIT_FEE_ADDRESS=shrol2...
# SHIELDED_DEPOSIT_FEE_VIEW_KEY=shview2...
# SHIELDED_DEPOSIT_FEE_SATS=0
# SHIELDED_DEPOSIT_FEE_BPS=0
