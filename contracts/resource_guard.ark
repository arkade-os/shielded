pragma arkade ^0.1.0;
import "./types.ark";
import "./encoding.ark";
import "./envelope.ark";

library ResourceGuard {
    function consume(
        Deployment cfg, GatePins gate, AssetId identity, int expectedKind
    ) ResourceChange {
        int inputIndex = this.activeInputIndex;
        require(inputIndex > 0, "verifier occupies input zero");
        require(tx.inputs[0].scriptPubKey == gate.program, "wrong verifier lock");

        bytes planBytes = Envelope.plan(cfg);
        int operation = Envelope.mode(planBytes);
        if (operation == Envelope.SEAL) {
            require(tx.inputs[0].arkadeScriptHash == gate.sealScriptHash,
                    "wrong seal closure");
        } else {
            require(operation == Envelope.TRANSFER || operation == Envelope.BOUNDARY,
                    "unsupported mode");
            require(tx.inputs[0].arkadeScriptHash == gate.applyScriptHash,
                    "wrong apply closure");
        }

        bytes transitionRow = Envelope.row(planBytes, inputIndex);
        require(Encoding.readU(transitionRow, 0, 1) == expectedKind, "resource kind");
        int outputIndex = Encoding.readU(transitionRow, 1, 4);
        // A bounded prototype layout: resource input i continues at output i.
        // This prevents two consumed resources from claiming the same output.
        require(outputIndex == inputIndex, "non-unique continuation");
        require(outputIndex < tx.numOutputs - 1, "extension is not continuation");

        Outpoint previous = tx.inputs[inputIndex].outpoint;
        bytes oldPacket = tx.inputs[inputIndex].packet(cfg.statePacketType);
        bytes oldRecord = Envelope.record(oldPacket, cfg, previous.vout);
        bytes newPacket = tx.packet(cfg.statePacketType);
        require(Envelope.stateCount(newPacket, cfg) == tx.numOutputs);
        bytes newRecord = Envelope.record(newPacket, cfg, outputIndex);
        require(Encoding.readU(oldRecord, 0, 1) == expectedKind);
        require(Encoding.readU(newRecord, 0, 1) == expectedKind);
        require(sha256(oldRecord) == substr(transitionRow, 5, 32), "old state");
        require(sha256(newRecord) == substr(transitionRow, 37, 32), "new state");

        require(tx.inputs[inputIndex].assets.lookup(identity.txid, identity.gidx) == 1,
                "missing input identity");
        require(tx.outputs[outputIndex].assets.lookup(identity.txid, identity.gidx) == 1,
                "missing output identity");
        require(tx.outputs[outputIndex].scriptPubKey == tx.inputs[inputIndex].scriptPubKey,
                "changed resource program");

        ResourceChange result = {
            inputIndex: inputIndex, outputIndex: outputIndex, mode: operation,
            beforeState: oldRecord, afterState: newRecord,
            deposit: Encoding.readU(transitionRow, 69, 8),
            withdrawal: Encoding.readU(transitionRow, 77, 8)
        };
        return result;
    }
}
