# The pinned rapidsnark release binary needs GLIBCXX_3.4.32, newer than bookworm's, so the Node stages use trixie.
FROM --platform=linux/amd64 debian:trixie-slim AS rapidsnark
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN curl -fsSLo rapidsnark.zip https://github.com/iden3/rapidsnark/releases/download/v0.0.8/rapidsnark-linux-x86_64-v0.0.8.zip \
 && echo '2ec59e3aa5ff498e862d60b3b7abdcd094ea484271750ec1ea14fb7c1305e423  rapidsnark.zip' | sha256sum -c - \
 && unzip -q rapidsnark.zip && mkdir -p /out && install -m 0755 rapidsnark-linux-x86_64-v0.0.8/bin/prover /out/rapidsnark

# The ceremony's proving keys, each checked against the manifest pinned in the repo; the host never runs a setup.
FROM --platform=linux/amd64 node:24-trixie-slim AS rollup-keys
ARG SHIELDED_ROLLUP_KEYS_URL=https://github.com/arkade-os/shielded/releases/download/rollup-genesis-3-keys
WORKDIR /keys
COPY tools/fetch-rollup-keys.mjs rollup-keys/genesis-3.json ./
RUN node fetch-rollup-keys.mjs genesis-3.json "$SHIELDED_ROLLUP_KEYS_URL" /out/rollup-keys

FROM --platform=linux/amd64 node:24-trixie-slim AS app-build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM --platform=linux/amd64 golang:1.26.9-bookworm AS vm-build
WORKDIR /src/tools/vm
COPY tools/vm/go.mod tools/vm/go.sum ./
RUN go mod download
COPY tools/vm/ ./
RUN mkdir -p /out && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/shielded-vm .

FROM --platform=linux/amd64 node:24-trixie-slim AS runtime
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8792 SHIELDED_DATA_DIR=/data SHIELDED_ROLLUP_KEYS=/app/rollup-keys
WORKDIR /app
RUN mkdir -p /data && chown node:node /data
COPY --from=rollup-keys --chown=node:node /out/rollup-keys ./rollup-keys
COPY --from=rapidsnark --chown=node:node /out/rapidsnark ./bin/rapidsnark
COPY --from=vm-build --chown=node:node /out/shielded-vm ./bin/shielded-vm
COPY --from=app-build --chown=node:node /app/node_modules ./node_modules
COPY --from=app-build --chown=node:node /app/package.json ./package.json
COPY --from=app-build --chown=node:node /app/src ./src
COPY --from=app-build --chown=node:node /app/packages ./packages
COPY --from=app-build --chown=node:node /app/app/dist ./app/dist
VOLUME ["/data"]
USER node
EXPOSE 8792
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=10s --timeout=3s --retries=3 CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||8792)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "--experimental-eventsource", "--import", "tsx", "src/server.ts"]
