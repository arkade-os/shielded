  "source": {
    "entry": "recipient.ark",
    "files": {
      "recipient.ark": "pragma arkade ^0.1.0;\n// Ordinary holder-controlled native payout used after authorized unshielding.\ncontract PocRecipient(pubkey owner, int exitDelay) {\n    function spend(signature ownerSig) {\n        require(checkSig(ownerSig, owner), \"holder signature\");\n    }\n    function unilateral(signature ownerSig) tapscript {\n        require(older(exitDelay));\n        require(checkSig(ownerSig, owner));\n    }\n}\n"
    }
