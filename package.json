{
  "name": "@arkade-os/shielded-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node tools/patch-sdk.mjs",
    "dev": "concurrently -k \"npm:server\" \"npm:app\"",
    "server": "node --experimental-eventsource --import tsx src/noncustodial/server.ts",
    "app": "vite --config app/vite.config.ts --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --config app/vite.config.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:deployment": "node --import tsx tools/deployment-smoke.ts",
    "test:e2e": "node --import tsx tests/e2e.ts",
    "test:primitives": "node --import tsx circuits/smoke.ts",
    "vm:build": "node --import tsx tools/build-vm.ts",
    "compile": "node --import tsx tools/compile.ts",
    "setup": "node --import tsx tools/setup.ts",
    "demo": "node --import tsx tools/demo.ts",
    "vm:registry:build": "node --import tsx tools/build-vm.ts --registry",
    "server:noncustodial": "node --experimental-eventsource --import tsx src/noncustodial/server.ts",
    "server:legacy": "node --experimental-eventsource --import tsx src/server.ts",
    "test:noncustodial:deployment": "node --import tsx tools/noncustodial-deployment-smoke.ts",
    "registry:build": "node --import tsx tools/build-registry-server.ts",
    "test:registry": "node --import tsx tools/build-registry-server.ts --test",
    "mutinynet:readiness": "node --import tsx tools/mutinynet-readiness.ts",
    "stock:tools": "node tools/prepare-stock-tools.mjs",
    "stock:compile": "node circuits/stock/generate.mjs --compile",
    "stock:setup": "node tools/stock-setup.mjs",
    "server:stock": "node --experimental-eventsource --import tsx src/stock/server.ts",
    "test:stock:witness": "node --import tsx tools/stock-circuit-witness-smoke.ts",
    "test:stock:lifecycle": "node --import tsx tools/stock-lifecycle.ts",
    "test:stock:baseline-ten": "node --import tsx tools/stock-ten-leaf-baseline.ts",
    "stock:funding": "node --experimental-eventsource --import tsx tools/stock-funding-wallet.ts",
    "stock:bootstrap": "node --experimental-eventsource --import tsx tools/stock-bootstrap.ts",
    "stock:live": "node --experimental-eventsource --import tsx tools/stock-live-smoke.ts",
    "stock:qualify": "node --experimental-eventsource --import tsx tools/stock-profile-gate.ts"
  },
  "dependencies": {
    "@arkade-os/sdk": "0.4.77",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "@scure/base": "2.0.0",
    "@scure/btc-signer": "2.0.1",
    "circomlib": "2.0.5",
    "circomlibjs": "0.1.7",
    "express": "5.1.0",
    "ffjavascript": "^0.3.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "snarkjs": "0.7.6"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "circom2": "0.2.23",
    "concurrently": "9.2.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.1.4"
  }
}
