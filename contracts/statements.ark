pragma arkade ^0.1.0;
import "./types.ark";
import "./encoding.ark";
import "./envelope.ark";

library Statements {
    // EXAMPLE bounded profile. Four lanes fit the SEAL profile below.
    // Larger bounds unroll more code and MUST be measured against VM limits.
    const int MAX_INPUTS = 8;
    const int MAX_OUTPUTS = 12;

    function intent(Deployment cfg) bytes32 {
        return sha256("ArkShieldIntent:v1" + cfg.domain + cfg.parametersHash +
                      sha256(tx.packet(cfg.intentPacketType)));
    }

    function nativeIO() bytes32 {
        require(tx.numInputs >= 2 && tx.numInputs <= MAX_INPUTS, "input capacity");
        require(tx.numOutputs >= 3 && tx.numOutputs <= MAX_OUTPUTS, "output capacity");
        int extensionIndex = tx.numOutputs - 1;
        require(tx.outputs[extensionIndex].value == 0, "extension has BTC");
        require(tx.outputs[extensionIndex].assets.length == 0, "extension has assets");
        bytes32 result = sha256("ArkShieldNativeIO:v1" +
            Encoding.uintLE(tx.version, 4) + Encoding.uintLE(tx.locktime, 4) +
            Encoding.uintLE(tx.numInputs, 4) + Encoding.uintLE(tx.numOutputs, 4));
        int inputIndex = 0;
        for (MAX_INPUTS) {
            if (inputIndex < tx.numInputs) {
                Outpoint previous = tx.inputs[inputIndex].outpoint;
                bytes32 item = sha256(Encoding.uintLE(inputIndex, 4) + previous.txid +
                    Encoding.uintLE(previous.vout, 4) +
                    Encoding.uintLE(tx.inputs[inputIndex].value, 8) +
                    sha256(tx.inputs[inputIndex].scriptPubKey) +
                    Encoding.uintLE(tx.inputs[inputIndex].sequence, 4));
                result = sha256(result + 0x00 + item);
            }
            inputIndex = inputIndex + 1;
        }
        int outputIndex = 0;
        for (MAX_OUTPUTS) {
            if (outputIndex < extensionIndex) {
                bytes32 item = sha256(Encoding.uintLE(outputIndex, 4) +
                    Encoding.uintLE(tx.outputs[outputIndex].value, 8) +
                    sha256(tx.outputs[outputIndex].scriptPubKey));
                result = sha256(result + 0x01 + item);
            }
            outputIndex = outputIndex + 1;
        }
        // The last, value-free/asset-free extension script is NOT hashed here:
        // it contains the proof itself. Relevant non-proof packets are below.
        return result;
    }

    function transition(Deployment cfg) bytes32 {
        bytes planBytes = Envelope.plan(cfg);
        bytes stateBytes = tx.packet(cfg.statePacketType);
        require(Envelope.stateCount(stateBytes, cfg) == tx.numOutputs);
        // Asset packet 0 exists because every state resource carries an identity.
        // The circuit rejects fresh issuance and validates the full allocation map.
        // Arkade's native asset layer authenticates the input allocations.
        return sha256("ArkShieldTransition:v1" + cfg.domain + cfg.parametersHash +
            intent(cfg) + nativeIO() + sha256(planBytes) + sha256(stateBytes) +
            sha256(tx.packet(0)));
    }
}
