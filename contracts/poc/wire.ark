pragma arkade ^0.1.0;
library Wire {
    const int PUBLIC_A = 128;
    const int PUBLIC_B = 129;
    const int TRANSITION = 130;
    const int STATE = 131;
    const bytes FR = 0x010000f093f5e1439170b97948e833285d588181b64550b829a031e1724e6430;
    function scalar(bytes data, int offset, int modulus) int {
        bytes positive = substr(data, offset, 32) + 0x00;
        int result = bin2num(positive);
        require(result < modulus, "noncanonical field");
        return result;
    }
    function destination(bytes program) int {
        require(size(program) == 32, "payout program width");
        bytes digest = sha256(program) + 0x00;
        int message = bin2num(digest);
        bytes modulusBytes = FR + 0x00;
        int modulus = bin2num(modulusBytes);
        return modExp(message, 1, modulus);
    }
    function modulus() int {
        bytes encoded = FR + 0x00;
        return bin2num(encoded);
    }
    function operation() int {
        bytes data = tx.packet(TRANSITION);
        return scalar(data, 0, modulus());
    }
    function publicData() int[36] {
        int fieldModulus = modulus();
        bytes first = tx.packet(PUBLIC_A);
        bytes second = tx.packet(PUBLIC_B);
        bytes transition = tx.packet(TRANSITION);
        require(size(first) == 416, "intent packet A width");
        require(size(second) == 384, "intent packet B width");
        require(size(transition) == 352, "transition packet width");
        return [
            scalar(first, 0, fieldModulus),
            scalar(first, 32, fieldModulus),
            scalar(first, 64, fieldModulus),
            scalar(first, 96, fieldModulus),
            scalar(first, 128, fieldModulus),
            scalar(first, 160, fieldModulus),
            scalar(first, 192, fieldModulus),
            scalar(first, 224, fieldModulus),
            scalar(first, 256, fieldModulus),
            scalar(first, 288, fieldModulus),
            scalar(first, 320, fieldModulus),
            scalar(first, 352, fieldModulus),
            scalar(first, 384, fieldModulus),
            scalar(second, 0, fieldModulus),
            scalar(second, 32, fieldModulus),
            scalar(second, 64, fieldModulus),
            scalar(second, 96, fieldModulus),
            scalar(second, 128, fieldModulus),
            scalar(second, 160, fieldModulus),
            scalar(second, 192, fieldModulus),
            scalar(second, 224, fieldModulus),
            scalar(second, 256, fieldModulus),
            scalar(second, 288, fieldModulus),
            scalar(second, 320, fieldModulus),
            scalar(second, 352, fieldModulus),
            scalar(transition, 0, fieldModulus),
            scalar(transition, 32, fieldModulus),
            scalar(transition, 64, fieldModulus),
            scalar(transition, 96, fieldModulus),
            scalar(transition, 128, fieldModulus),
            scalar(transition, 160, fieldModulus),
            scalar(transition, 192, fieldModulus),
            scalar(transition, 224, fieldModulus),
            scalar(transition, 256, fieldModulus),
            scalar(transition, 288, fieldModulus),
            scalar(transition, 320, fieldModulus)
        ];
    }
    function state(int[36] data) {
        int fieldModulus = modulus();
        bytes previous = tx.inputs[1].packet(STATE);
        bytes next = tx.packet(STATE);
        require(size(previous) == 160 && size(next) == 160, "lane state width");
        require(scalar(previous, 0, fieldModulus) == data[26], "old state field");
        require(scalar(next, 0, fieldModulus) == data[27], "new state field");
        require(scalar(previous, 32, fieldModulus) == data[28], "old state field");
        require(scalar(next, 32, fieldModulus) == data[29], "new state field");
        require(scalar(previous, 64, fieldModulus) == data[30], "old state field");
        require(scalar(next, 64, fieldModulus) == data[31], "new state field");
        require(scalar(previous, 96, fieldModulus) == data[32], "old state field");
        require(scalar(next, 96, fieldModulus) == data[33], "new state field");
        require(scalar(previous, 128, fieldModulus) == data[34], "old state field");
        require(scalar(next, 128, fieldModulus) == data[35], "new state field");
    }
}
