pragma arkade ^0.1.0;

library Encoding {
    // Arkade bin2num is SIGN-MAGNITUDE, not unsigned little-endian.
    // Appending a zero byte makes a wire unsigned integer positive.
    function readU(bytes data, int offset, int width) int {
        require(offset >= 0);
        require(width >= 1 && width <= 32);
        require(offset + width <= size(data));
        bytes positiveBytes = substr(data, offset, width) + 0x00;
        return bin2num(positiveBytes);
    }

    function uintLE(int value, int width) bytes {
        require(value >= 0);
        require(width >= 1 && width <= 32);
        int paddedWidth = width + 1;
        bytes padded = num2bin(value, paddedWidth);
        bytes result = substr(padded, 0, width);
        // Reject truncation, including overflow beyond the requested width.
        bytes roundtripBytes = result + 0x00;
        require(bin2num(roundtripBytes) == value, "unsigned overflow");
        return result;
    }

    function digestLimbs(bytes32 digestValue) int[8] {
        int[8] result = [0, 0, 0, 0, 0, 0, 0, 0];
        int index = 0;
        for (8) {
            result[index] = readU(digestValue, index * 4, 4);
            index = index + 1;
        }
        return result;
    }
}
