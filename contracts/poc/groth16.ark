pragma arkade ^0.1.0;
import "./types.ark";
library Groth16 {
    function coordinate(bytes32 digestValue, int value) bytes32 {
        return sha256(digestValue + num2bin(value, 32));
    }
    function intentKeyHash(IntentKey key) bytes32 {
        bytes32 result = sha256("ArkShieldPocVk:Intent:v1");
        result = coordinate(result, key.alpha.x);
        result = coordinate(result, key.alpha.y);
        result = coordinate(result, key.betaNeg.xc1);
        result = coordinate(result, key.betaNeg.xc0);
        result = coordinate(result, key.betaNeg.yc1);
        result = coordinate(result, key.betaNeg.yc0);
        result = coordinate(result, key.gammaNeg.xc1);
        result = coordinate(result, key.gammaNeg.xc0);
        result = coordinate(result, key.gammaNeg.yc1);
        result = coordinate(result, key.gammaNeg.yc0);
        result = coordinate(result, key.deltaNeg.xc1);
        result = coordinate(result, key.deltaNeg.xc0);
        result = coordinate(result, key.deltaNeg.yc1);
        result = coordinate(result, key.deltaNeg.yc0);
        for (index, value) in key.icX { result = coordinate(result, value); }
        for (index, value) in key.icY { result = coordinate(result, value); }
        return result;
    }
    function transitionKeyHash(TransitionKey key) bytes32 {
        bytes32 result = sha256("ArkShieldPocVk:Transition:v1");
        result = coordinate(result, key.alpha.x);
        result = coordinate(result, key.alpha.y);
        result = coordinate(result, key.betaNeg.xc1);
        result = coordinate(result, key.betaNeg.xc0);
        result = coordinate(result, key.betaNeg.yc1);
        result = coordinate(result, key.betaNeg.yc0);
        result = coordinate(result, key.gammaNeg.xc1);
        result = coordinate(result, key.gammaNeg.xc0);
        result = coordinate(result, key.gammaNeg.yc1);
        result = coordinate(result, key.gammaNeg.yc0);
        result = coordinate(result, key.deltaNeg.xc1);
        result = coordinate(result, key.deltaNeg.xc0);
        result = coordinate(result, key.deltaNeg.yc1);
        result = coordinate(result, key.deltaNeg.yc0);
        for (index, value) in key.icX { result = coordinate(result, value); }
        for (index, value) in key.icY { result = coordinate(result, value); }
        return result;
    }

    function verifyIntent(IntentKey key, int[25] signals, Proof proof) {
        int accumulatorX = key.icX[0];
