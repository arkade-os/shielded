@@ -0,0 +1,26 @@
+import { describe, expect, it } from "vitest";
+import { arkade } from "../src";
+
+describe("compiler variable assignment opcode", () => {
+    it("encodes, decodes and imports OP_PUT at the emulator's existing byte", () => {
+        expect(arkade.ARKADE_OP.PUT).toBe(0xbb);
+        const bytes = arkade.ArkadeScript.encode(["OP_1", "OP_0", "PUT"]);
+        expect(Array.from(bytes)).toEqual([0x51, 0x00, 0xbb]);
+        expect(arkade.ArkadeScript.decode(bytes)).toEqual([1, 0, "PUT"]);
+
+        const program = arkade.programFromArtifact({
+            contractName: "Assignment",
+            constructorInputs: [],
+            functions: [{
+                name: "advance",
+                arkade: { inputs: [], asm: ["OP_1", "OP_0", "OP_PUT", "OP_1"] },
+                leaves: [{
+                    name: "advance",
+                    asm: ["<SERVER_KEY>", "OP_CHECKSIGVERIFY", "<EMULATOR_KEY:advance>", "OP_CHECKSIG"],
+                }],
+            }],
+        });
+        expect(program.functions.advance.arkadeScript?.asm).toEqual(["OP_1", "OP_0", "PUT", "OP_1"]);
+        expect(arkade.resolveAsm(program.functions.advance.arkadeScript!.asm, {})).toEqual(new Uint8Array([0x51, 0x00, 0xbb, 0x51]));
+    });
+});
