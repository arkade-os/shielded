pragma arkade ^0.1.0;
import "./resource.ark";
contract PocLane(bytes32 gateProgram, bytes32 applyClosure, bytes32 sealClosure, AssetId identity) {
    function advance() {
        Resource.leader(gateProgram, applyClosure, sealClosure);
        Resource.continueIdentity(identity, 1);
        require(tx.outputs[1].value == tx.inputs[1].value, "lane carrier");
        require(tx.inputs[1].assets.length == 1 && tx.outputs[1].assets.length == 1);
    }
}
