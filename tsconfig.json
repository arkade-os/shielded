{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "esModuleInterop": true, "resolveJsonModule": true,
    "skipLibCheck": true, "allowImportingTsExtensions": true, "noEmit": true
  },
  "include": ["src/**/*.ts", "packages/**/*.ts", "app/**/*.ts", "app/**/*.tsx", "tools/**/*.ts", "tests/**/*.ts"]
}
