{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shielded-main",
  "description": "Private transport and fixed wallet seed for the bundled wallet",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-native-status",
    "allow-native-start",
    "allow-native-pause",
    "allow-native-scope",
    "allow-native-scope-close",
    "allow-native-http",
    "allow-native-stream",
    "allow-native-stream-ack",
    "allow-native-socket",
    "allow-native-socket-send",
    "allow-native-cancel",
    "allow-native-android-update-info",
    "allow-native-android-update-download",
    "allow-native-android-update-cancel",
    "allow-native-android-update-permission",
    "allow-native-android-update-install",
    "allow-native-android-update-confirm",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://shielded.mutinynet.arkade.sh/#download" }, { "url": "https://shielded.mutinynet.arkade.sh/download#download" }]
    },
    "shielded-platform:allow-secret-get",
    "shielded-platform:allow-secret-set",
    "shielded-platform:allow-secret-clear"
  ]
}
