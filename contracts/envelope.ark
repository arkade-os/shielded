pragma arkade ^0.1.0;
import "./types.ark";
import "./encoding.ark";

library Envelope {
    const int TRANSFER = 1;
    const int BOUNDARY = 2;
    const int SEAL = 3;
    const int LANE = 1;
    const int BTC_VAULT = 2;
    const int ASSET_VAULT = 3;
    const int PLAN_HEADER = 77;
    const int PLAN_ROW = 85;
    const int STATE_HEADER = 72;
    const int STATE_RECORD = 160;
    const int MAX_RECORDS = 64;

    // Plan header: "AKP1" | domain32 | params32 | mode1 | nin4 | nout4.
    // Plan has ONE row per native input, including empty non-resource rows.
    function plan(Deployment cfg) bytes {
        bytes data = tx.packet(cfg.planPacketType);
        require(size(data) >= PLAN_HEADER, "short plan");
        require(substr(data, 0, 4) == "AKP1", "plan version");
        require(substr(data, 4, 32) == cfg.domain, "plan domain");
        require(substr(data, 36, 32) == cfg.parametersHash, "plan profile");
        require(Encoding.readU(data, 69, 4) == tx.numInputs, "input count");
        require(Encoding.readU(data, 73, 4) == tx.numOutputs, "output count");
        require(tx.numInputs <= MAX_RECORDS);
        require(tx.numOutputs <= MAX_RECORDS);
        require(size(data) == PLAN_HEADER + tx.numInputs * PLAN_ROW,
                "plan trailing bytes");
        return data;
    }

    function mode(bytes data) int {
        return Encoding.readU(data, 68, 1);
    }

    function row(bytes data, int inputIndex) bytes {
        require(inputIndex >= 0 && inputIndex < tx.numInputs);
        int offset = PLAN_HEADER + inputIndex * PLAN_ROW;
        return substr(data, offset, PLAN_ROW);
    }

    // State packet: "AKS1" | domain32 | params32 | nout4 | records[nout].
    // Each record belongs to its native OUTPUT INDEX, not its next input index.
    function stateCount(bytes data, Deployment cfg) int {
        require(size(data) >= STATE_HEADER, "short state packet");
        require(substr(data, 0, 4) == "AKS1", "state version");
        require(substr(data, 4, 32) == cfg.domain, "state domain");
        require(substr(data, 36, 32) == cfg.parametersHash, "state profile");
        int count = Encoding.readU(data, 68, 4);
        require(count > 0 && count <= MAX_RECORDS, "state count");
        require(size(data) == STATE_HEADER + count * STATE_RECORD,
                "state trailing bytes");
        return count;
    }

    function record(bytes data, Deployment cfg, int outputIndex) bytes {
        int count = stateCount(data, cfg);
        require(outputIndex >= 0 && outputIndex < count, "state output index");
        int offset = STATE_HEADER + outputIndex * STATE_RECORD;
        return substr(data, offset, STATE_RECORD);
    }
}
