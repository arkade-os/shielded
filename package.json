{
  "name": "@arkade-os/shielded-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "server": "node --experimental-eventsource --import tsx src/server.ts",
    "app": "vite --config app/vite.config.ts --host 127.0.0.1 --force",
    "build": "tsc --noEmit && vite build --config app/vite.config.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "sdk:build": "tsc -p packages/shielded/tsconfig.json",
    "vm:build": "node --import tsx tools/build-vm.ts",
    "circom": "node tools/prepare-circom.mjs",
    "rollup:compile:epoch": "node circuits/rollup/generate-epoch.mjs",
    "rollup:budget:epoch": "node --max-old-space-size=8192 tools/rollup-epoch-budget.mjs",
    "rollup:setup:epoch-dev": "node --max-old-space-size=8192 tools/rollup-setup.mjs --development-only --single-thread --circuits epoch-spend,epoch-batch-recover --out circuits/rollup/build/keys-epoch-dev",
    "rollup:fixture:epoch-covenant": "node --import tsx tools/rollup-epoch-covenant-fixture.ts",
    "test:rollup:epoch-witness": "node --import tsx tools/rollup-epoch-circuit-witness-smoke.ts",
    "test:rollup:epoch-prove": "node --max-old-space-size=16384 --import tsx tools/rollup-epoch-prove-smoke.ts",
    "funding": "node --experimental-eventsource --import tsx tools/stock-funding-wallet.ts",
    "fallback": "node --max-old-space-size=8192 --experimental-eventsource --import tsx tools/rollup-fallback.ts",
    "fee:keeper": "node --experimental-eventsource --import tsx tools/shielded-fee-keeper.ts",
    "ohttp:keygen": "node --import tsx tools/ohttp-keygen.ts",
    "tauri": "tauri",
    "native:frontend": "node tools/native-frontend.mjs",
    "native:dev": "node tools/native-build.mjs desktop dev",
    "native:build": "node tools/native-build.mjs desktop build",
    "native:android": "node tools/native-build.mjs android",
    "native:ios": "node tools/native-build.mjs ios",
    "native:icons": "node tools/native-build.mjs icons",
    "native:check": "tsc --noEmit && cargo test --manifest-path src-tauri/Cargo.toml --workspace"
  },
  "dependencies": {
    "@arkade-os/lnurl-client": "0.9.2",
    "@arkade-os/sdk": "0.5.6",
    "@arkade-os/swap": "0.1.3",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@scure/btc-signer": "2.4.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-deep-link": "2.6.3",
    "@tauri-apps/plugin-opener": "2.7.2",
    "circomlib": "2.0.5",
    "circomlibjs": "0.1.7",
    "compression": "1.8.2",
    "express": "5.3.0",
    "ffjavascript": "^0.3.1",
    "hpke": "1.1.8",
    "nostr-tools": "2.24.1",
    "ohttp-ts": "0.6.2",
    "qr": "0.7.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "snarkjs": "0.7.6",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "overrides": {
    "@arkade-os/sdk": "$@arkade-os/sdk"
  }
}
