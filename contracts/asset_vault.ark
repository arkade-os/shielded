pragma arkade ^0.1.0;
import "./types.ark";
import "./envelope.ark";
import "./resource_guard.ark";

contract ShieldedAssetVault(
    Deployment cfg, GatePins gate, AssetId identity, AssetId token
) {
    function advance() {
        ResourceChange change = ResourceGuard.consume(cfg, gate, identity, Envelope.ASSET_VAULT);
        int inputIndex = change.inputIndex;
        int outputIndex = change.outputIndex;
        require(change.mode == Envelope.BOUNDARY, "vault only at boundary");
        require(identity.txid != token.txid || identity.gidx != token.gidx,
                "reserve is identity asset");
        int beforeAmount = 0;
        if (tx.inputs[inputIndex].assets.has(token.txid, token.gidx)) {
            beforeAmount = tx.inputs[inputIndex].assets.lookup(token.txid, token.gidx);
            require(tx.inputs[inputIndex].assets.length == 2);
        } else {
            require(tx.inputs[inputIndex].assets.length == 1);
        }
        int afterAmount = 0;
        if (tx.outputs[outputIndex].assets.has(token.txid, token.gidx)) {
            afterAmount = tx.outputs[outputIndex].assets.lookup(token.txid, token.gidx);
            require(tx.outputs[outputIndex].assets.length == 2);
        } else {
            require(tx.outputs[outputIndex].assets.length == 1);
        }
        require(beforeAmount + change.deposit == afterAmount + change.withdrawal,
                "asset reserve delta");
        require(tx.outputs[outputIndex].value == tx.inputs[inputIndex].value,
                "token carrier drained");
        // The state proof binds withdrawals to the exact native payout outputs.
        // Native Arkade validation must authenticate the declared input assets.
    }
}
