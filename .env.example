SHIELDED_NETWORK=mutinynet
SHIELDED_PROOF_TRANSPORT=compact
SHIELDED_BIND_PORT=8787
SHIELDED_API_TOKEN=
ARK_SERVER_URL=https://mutinynet.arkade.sh
EMULATOR_URL=https://emulator.mutinynet.arkade.sh
# Compact is the deployable path; use inline only for the original local VM demonstration.
# Start with a fresh data directory: encrypted checkpoints are bound to their original transport.
# Optional. If unset, the service creates and stores an encryption key in the named volume.
# SHIELDED_STORAGE_KEY=
